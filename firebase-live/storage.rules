rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isYousefManager() {
      return request.auth != null
        && request.auth.token.email == 'yousefcreationz@gmail.com'
        && request.auth.token.email_verified == true;
    }

    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if isYousefManager();
    }
  }
}
