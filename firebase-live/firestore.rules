rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isYousefManager() {
      return request.auth != null
        && request.auth.token.email == 'yousefcreationz@gmail.com';
    }

    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isYousefManager();
    }
  }
}
